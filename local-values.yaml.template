database:
  dbName: "mattermost"
  auth:
    existingSecret: "k3s-database-secret"   # <--- Name of the K3s secret managed on the cluster
  persistence:
    existingClaim: "mattermost-db-pvc"
    storageClass: "local-path"

mattermost:
  image:
    repository: "mattermost/mattermost-team-edition"   # <--- Update for your target architecture if needed (e.g. ARM64)
    tag: "latest"
    pullPolicy: IfNotPresent
  excludedNode: ""   # <--- Optional: Node name to forbid running on, or leave blank
  existingSecret: "k3s-database-secret"
  persistence:
    dataExistingClaim: "mattermost-team-edition"
    pluginsExistingClaim: "mattermost-team-edition-plugins"
    storageClass: "local-path"

ollama-bridge:
  enabled: true
  image:
    registry: "local-registry:5000"
    repository: "library/ollama-bridge"
    tag: "latest"
    pullPolicy: Always
  #nodeName: ""   # <--- Optional: hardcode the node to pin it to (must comment out excludedNode below)
  excludedNode: ""   # <--- Optional: Node name to forbid running on, or leave blank
  env:
    OLLAMA_HOST: "http://your-ollama-server-ip:11434"
    MATTERMOST_URL: "http://mattermost-team-edition:8065"
    OLLAMA_TIMEOUT: "120" # <--- set to your liking
    # Comma-separated list of models corresponding 1-to-1 with your bot tokens below
  models:
    - "model1"
    - "model2"
    - "model3"
  botTokens:
    - "token1"  
    - "token2"  
    - "token3"
